# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Remember to put your database name before the "?" e.g. .../musicSurvey?retryWrites=true...
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/musicSurvey?retryWrites=true&w=majority

# A long random string. Used to scramble the anonymous browser ID before it is stored.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: do not change it after you start collecting data, or repeat visitors
# will no longer be linked to their earlier responses.
HASH_SECRET=replace-me-with-a-long-random-string

PORT=3000
NODE_ENV=development

# Optional: max submissions accepted per IP address every 15 minutes.
# Kept generous because many students can share one campus Wi-Fi IP.
SUBMIT_LIMIT_PER_15_MIN=60
